#!/usr/bin/env bash
# claude-status - Claude Code セッション状態表示 (herdr風)
#
# .config/claude/hooks/update-state.sh が hooks 経由で書き込む
# ~/.local/state/claude/sessions/*.json を読んで表示する。
#
# Usage:
#   claude-status bar       # tmux status-right 用の状態別カウント (#[fg=..]付き)
#   claude-status list      # サイドバー1画面分を描画
#   claude-status watch     # list をループ描画 (サイドバーpane用、q で終了)
#   claude-status sessions  # "tmux_session<TAB>glyph" 一覧 (fzf装飾用)
#   claude-status jump      # 最優先セッション (🔔入力待ち優先) にジャンプ (tmux prefix+u)
#   claude-status detail <session_id>  # 詳細表示 (サイドバーの i キーからpopupで呼ばれる)

export PATH="/opt/homebrew/bin:/usr/bin:/bin:$PATH"

# ロケール未設定環境ではbashの部分文字列 (${var:0:n}) がバイト単位になり
# マルチバイト文字が途中で切れるため、UTF-8をフォールバックに設定
# (C.UTF-8はmacOS/Linux両方に存在する)
[ -z "${LANG:-}" ] && export LANG=C.UTF-8

STATE_DIR="${HOME}/.local/state/claude/sessions"

GLYPH_WORKING="⚙"
GLYPH_WAITING="🔔"
GLYPH_IDLE="✓"

# Catppuccin Mocha
C_WORKING=$'\033[38;2;137;180;250m'   # blue
C_WAITING=$'\033[38;2;249;226;175m'   # yellow
C_IDLE=$'\033[38;2;108;112;134m'      # overlay0
C_DIM=$'\033[38;2;127;132;156m'       # overlay1
C_BOLD=$'\033[1m'
C_RESET=$'\033[0m'

# 異常終了で残った1日以上前の状態ファイルを掃除。
# bar は status-interval ごと、watch は2秒ごとに起動するため、毎回 find -delete を
# 走らせると update-state.sh の mv と競合しつつ無駄なI/Oを生む。スタンプファイルで
# 1時間に1回までに制限する。
CLEANUP_STAMP="${STATE_DIR}/.last-cleanup"
cleanup_stale() {
    [ -d "$STATE_DIR" ] || return 0
    if [ -f "$CLEANUP_STAMP" ] && [ -z "$(find "$CLEANUP_STAMP" -mmin +60 2>/dev/null)" ]; then
        return 0
    fi
    : > "$CLEANUP_STAMP" 2>/dev/null
    find "$STATE_DIR" -name '*.json' -mmin +1440 -delete 2>/dev/null
    # hook が mv 前に死ぬと *.json.tmp.PID が残り、*.json にマッチしないため
    # 永久に溜まる
    find "$STATE_DIR" -name '*.json.tmp.*' -mmin +60 -delete 2>/dev/null
}

# 全セッションを「waiting → working → idle、同状態内は更新の新しい順」で出力
# フィールド: status / project / tmux_session / tmux_window / tmux_pane /
#             tmux_pane_index / updated_at / message / note / session_id
# message は最後のプロンプト (=何の作業か)。ただし最後のプロンプトが短い
# (「続けて」等、16文字未満) 場合は最初のプロンプト (=セッションの本題) を表示。
# note は状態に応じた補足: 入力待ち→通知メッセージ、待機→Claudeの最後の返答
# 区切りは US (\x1f)。タブはbashのIFSで空白扱いになり連続時に空フィールドが潰れるため使わない
ROW_SEP=$'\x1f'

# 壊れた状態ファイルを退避する。
# jq -s は複数ファイルのうち1つでもパースに失敗すると全体が空出力で終わるため、
# 1個の壊れたファイルで status bar・サイドバー・fzfグリフが全セッション分
# 消える。高速パス (jq 1回) が失敗したときだけ1ファイルずつ検証して隔離する。
quarantine_broken() {
    local f
    for f in "$STATE_DIR"/*.json; do
        [ -e "$f" ] || continue
        jq -e . "$f" >/dev/null 2>&1 && continue
        mv "$f" "${f}.broken" 2>/dev/null
    done
}

rows() {
    set -- "$STATE_DIR"/*.json
    [ -e "$1" ] || return 0
    local out
    out=$(rows_jq "$@")
    if [ -z "$out" ]; then
        quarantine_broken
        set -- "$STATE_DIR"/*.json
        [ -e "$1" ] || return 0
        out=$(rows_jq "$@")
    fi
    [ -n "$out" ] && printf '%s\n' "$out"
    return 0
}

rows_jq() {
    jq -rs '
        def prio: {waiting: 0, working: 1, idle: 2}[.] // 3;
        map({
            status: (.status // "idle"),
            project: (.project // "?"),
            tmux_session: (.tmux_session // ""),
            tmux_window: (.tmux_window // ""),
            tmux_pane: (.tmux_pane // ""),
            tmux_pane_index: (.tmux_pane_index // ""),
            # 数値以外が入っていても sort_by(-.updated_at) が落ちないように丸める
            updated_at: (.updated_at | if type == "number" then . else 0 end),
            message: ((.last_prompt // "") as $lp
                      | (.first_prompt // "") as $fp
                      | (if ($lp | length) < 16 and $fp != "" and $fp != $lp
                         then $fp else $lp end)
                      | gsub("[\\x00-\\x1f]"; " ")),
            note: ((if .status == "waiting" then .last_notification
                    elif .status == "idle" then .last_reply
                    else "" end)
                   // "" | gsub("[\\x00-\\x1f]"; " ")),
            session_id: (.session_id // "")
        })
        | sort_by([(.status | prio), -.updated_at])
        | .[]
        | [.status, .project, .tmux_session, .tmux_window, .tmux_pane,
           .tmux_pane_index, (.updated_at | tostring), .message, .note, .session_id]
        | join("\u001f")
    ' "$@" 2>/dev/null
}

# 指定セッションを表示しているGhosttyウィンドウをOSレベルで前面化する。
# tmuxがウィンドウタイトルを "セッション名: ディレクトリ" に設定している
# (set-titles-string) ことを利用したタイトル前方一致検索。
# 1. Hammerspoon (hs CLI) があれば hs.spaces で仮想デスクトップ (Space) 越しに
#    フォーカス (.config/hammerspoon/init.lua の claudeFocusGhosttyWindow)
# 2. なければ System Events でAXRaise (現在のSpaceのウィンドウしか発見できない)
# 初回はmacOSのオートメーション/アクセシビリティ許可ダイアログが出る。
# 無効化: CLAUDE_JUMP_FOCUS_DISABLED=1
# 任意のバイト列をLua文字列リテラルの中身へ変換する (\DDD の10進エスケープ)。
# クォート・改行・バックスラッシュを含む入力でもLua構文を壊せない。
lua_escape() {
    # awk は使わない: macOS の awk は printf の出力に含まれる \NNN を
    # 再度エスケープとして解釈してしまい、\045 が "%" に化ける
    printf '%s' "$1" | od -An -tu1 -v | tr -s ' ' '\n' | grep . | \
        while IFS= read -r b; do printf '\\%03d' "$b"; done
}

raise_window_for_session() {
    local sess=$1
    [ -z "$sess" ] && return 1
    [ "${CLAUDE_JUMP_FOCUS_DISABLED:-0}" = "1" ] && return 1
    local prefix="${sess}: "
    if command -v hs >/dev/null 2>&1; then
        local out
        # hs -c は文字列をLuaとして評価するため、セッション名の埋め込みは
        # 実質 eval になる。sed 2つの手書きエスケープではなく全バイトを
        # 10進エスケープしてリテラル化する (AppleScript側は argv 渡しで安全)。
        out=$(hs -c "claudeFocusGhosttyWindow(\"$(lua_escape "$prefix")\")" 2>/dev/null)
        [ "$out" = "true" ] && return 0
    fi
    command -v osascript >/dev/null 2>&1 || return 1
    osascript - "$prefix" <<'APPLESCRIPT' >/dev/null 2>&1
on run argv
    set target to item 1 of argv
    tell application "System Events"
        tell process "Ghostty"
            repeat with w in windows
                if name of w starts with target then
                    perform action "AXRaise" of w
                    set frontmost to true
                    return
                end if
            end repeat
        end tell
    end tell
    error "no matching window"
end run
APPLESCRIPT
}

# 対象セッションと同じリポジトリ (worktree) の別セッションを表示中の
# クライアント (=そのリポジトリ用のGhosttyウィンドウ) を探す。
# 1つのworktree内に複数のtmuxセッションを作る運用で、対象セッションが
# どのウィンドウにも表示されていないときの受け皿。
# worktree判定は各セッションのアクティブpaneのパスの git toplevel 一致。
# セッションの現在windowのアクティブpaneのカレントパスを返す
# (display-message -t はクライアント文脈なしだと空を返す環境があるため list-panes を使う)
session_path() {
    tmux list-panes -t "=$1" -F '#{?pane_active,#{pane_current_path},}' 2>/dev/null | grep -m1 .
}

find_sibling_client() {
    local tsess=$1
    local tpath troot client csess cpath croot
    tpath=$(session_path "$tsess")
    [ -n "$tpath" ] || return 1
    troot=$(git -C "$tpath" rev-parse --show-toplevel 2>/dev/null)
    [ -n "$troot" ] || return 1
    # 注意: tmuxの-F出力は非印字文字を\037等にエスケープするためROW_SEPは使えない。
    # クライアント名 (/dev/ttysNNN) にスペースは入らないのでスペース区切りで分割し、
    # セッション名側は read の残余フィールドとして受ける (スペース入りセッション名も安全)
    while read -r client csess; do
        [ -n "$client" ] || continue
        cpath=$(session_path "$csess")
        [ -n "$cpath" ] || continue
        croot=$(git -C "$cpath" rev-parse --show-toplevel 2>/dev/null)
        if [ -n "$croot" ] && [ "$croot" = "$troot" ]; then
            printf '%s %s' "$client" "$csess"
            return 0
        fi
    done <<EOF
$(tmux list-clients -F '#{client_name} #{client_session}' 2>/dev/null)
EOF
    return 1
}

# 指定のtmux位置に切り替える (セッション → window → pane の順で絞り込み)
# 1. 対象セッションを表示中のGhosttyウィンドウがあれば前面化。
#    前面化できない場合 (別Space + Hammerspoonなし等) は無反応にせず
#    現在のクライアントを切り替える
# 2. 同じworktreeの別セッションを表示中のウィンドウがあれば、先にそのウィンドウを
#    前面化してから (タイトルが正確なうちに) そのクライアントを切り替える
# 3. どちらもなければ現在のクライアントをswitch-client
jump_to() {
    local tsess=$1 twin=$2 tpane=$3
    [ -z "$tsess" ] && return 1

    # セッションが生きていなければ何もしない。hook は SIGKILL や
    # tmux kill-session では発火しないため、状態ファイルは死んだセッションを
    # 24時間指し続ける。"=" は前方一致/fnmatch ではなく厳密一致を強制する。
    tmux has-session -t "=$tsess" 2>/dev/null || return 1

    # window/pane選択はセッション単位の状態なので、どのクライアントで表示していても効く。
    # pane ID はtmuxサーバ再起動でリセットされるので、対象セッションに属することを
    # 確認してから選択する。確認せずに select-pane すると無関係なウィンドウの
    # アクティブpaneを書き換えてしまう。
    [ -n "$twin" ] && tmux select-window -t "=${tsess}:${twin}" 2>/dev/null
    if [ -n "$tpane" ] && tmux list-panes -s -t "=$tsess" -F '#{pane_id}' 2>/dev/null \
            | grep -qxF "$tpane"; then
        tmux select-pane -t "$tpane" 2>/dev/null
    fi

    # grep -qxF: セッション名を正規表現ではなくリテラルとして扱う
    # (foo.bar が無関係な fooxbar にマッチしていた)
    if tmux list-clients -F '#{client_session}' 2>/dev/null | grep -qxF "$tsess"; then
        raise_window_for_session "$tsess" && return 0
        tmux switch-client -t "=$tsess" 2>/dev/null || return 1
        return 0
    fi
    local sib scsess
    read -r sib scsess <<EOF
$(find_sibling_client "$tsess")
EOF
    if [ -n "$sib" ]; then
        raise_window_for_session "$scsess"
        tmux switch-client -c "$sib" -t "=$tsess" 2>/dev/null && return 0
    fi
    tmux switch-client -t "=$tsess" 2>/dev/null || return 1
    return 0
}

# 最優先セッション (🔔入力待ち > ⚙作業中 > ✓待機) にジャンプ
render_jump() {
    local status project tsess twin tpane tpidx updated message note sid
    while IFS="$ROW_SEP" read -r status project tsess twin tpane tpidx updated message note sid; do
        [ -z "$status" ] && continue
        [ -z "$tsess" ] && continue
        jump_to "$tsess" "$twin" "$tpane" && return 0
    done <<EOF
$(rows)
EOF
    # 全部失敗したときに無反応だと未バインドのキーと区別がつかない。
    # 死んだセッションしか残っていない場合 (hook は SIGKILL では発火しない) に
    # ここへ来る。
    tmux display-message "claude-status: no live Claude session to jump to" 2>/dev/null
    return 1
}

# 状態ファイル由来の値を算術で使う前に整数であることを確認する。
# bash の $(( )) は変数の「内容」を再帰評価するため、updated_at に
# a[$(cmd)] のような文字列が書き込まれていると任意コマンドが実行される。
as_int() {
    case "$1" in
        ''|*[!0-9]*) printf '0' ;;
        *)           printf '%s' "$1" ;;
    esac
}

fmt_age() {
    local s=$1
    [ "$s" -lt 0 ] && s=0
    if [ "$s" -lt 60 ]; then
        printf '%ds' "$s"
    elif [ "$s" -lt 3600 ]; then
        printf '%dm' $((s / 60))
    else
        printf '%dh%02dm' $((s / 3600)) $(((s % 3600) / 60))
    fi
}

glyph_for() {
    case "$1" in
        working) printf '%s' "$GLYPH_WORKING" ;;
        waiting) printf '%s' "$GLYPH_WAITING" ;;
        *)       printf '%s' "$GLYPH_IDLE" ;;
    esac
}

color_for() {
    case "$1" in
        working) printf '%s' "$C_WORKING" ;;
        waiting) printf '%s' "$C_WAITING" ;;
        *)       printf '%s' "$C_IDLE" ;;
    esac
}

# サイドバー描画。ジャンプ先を TARGETS[n] ("session \t window \t pane") に記録する
TARGETS=()

# watchモードでは各行末に \033[K (行末まで消去) を付けてちらつきなく上書き描画する
EOL=""

render_list() {
    local width=${1:-44}
    # 極端に狭いpaneでも substring が負数にならないよう下限を設ける
    [ "$width" -ge 20 ] 2>/dev/null || width=20
    local now total=0 cw=0 cn=0 ci=0
    now=$(date +%s)
    TARGETS=()

    local body=""
    local status project tsess twin tpane tpidx updated message note sid
    while IFS="$ROW_SEP" read -r status project tsess twin tpane tpidx updated message note sid; do
        [ -z "$status" ] && continue
        total=$((total + 1))
        case "$status" in
            working) cw=$((cw + 1)) ;;
            waiting) cn=$((cn + 1)) ;;
            *)       ci=$((ci + 1)) ;;
        esac
        # 表示名はtmuxセッション名を優先。ただしセッション名からプロジェクトが
        # 判別できない場合 (例: Ghostty既定の "main" セッション) はプロジェクト名を併記
        local name=${tsess:-$project}
        if [ -n "$tsess" ] && [ -n "$project" ] && [ "$project" != "?" ]; then
            local tsess_lc project_lc
            tsess_lc=$(printf '%s' "$tsess" | tr '[:upper:]' '[:lower:]')
            project_lc=$(printf '%s' "$project" | tr '[:upper:]' '[:lower:]')
            if [[ "$tsess_lc" != *"$project_lc"* ]]; then
                name="${tsess}:${project}"
            fi
        fi
        # 同一tmuxセッション内で複数Claudeを走らせても区別できるよう
        # window.pane 位置を併記 (例: "ishihama-dotfiles 2.1")
        local loc=""
        if [ -n "$twin" ]; then
            loc=" ${twin}${tpidx:+.$tpidx}"
        fi
        local age glyph color idx=""
        age=$(fmt_age $((now - $(as_int "$updated"))))
        glyph=$(glyph_for "$status")
        color=$(color_for "$status")
        if [ "$total" -le 9 ] && [ -n "$tsess" ]; then
            TARGETS[$total]="${tsess}"$'\t'"${twin}"$'\t'"${tpane}"$'\t'"${sid}"
            idx="${C_DIM}${total}${C_RESET} "
        else
            idx="  "
        fi
        body="${body} ${idx}${color}${glyph} ${name:0:$((width - 14))}${C_RESET}${C_DIM}${loc} (${age})${C_RESET}${EOL}"$'\n'
        if [ -n "$message" ]; then
            body="${body}     ${C_DIM}${message:0:$((width - 7))}${C_RESET}${EOL}"$'\n'
        fi
        if [ -n "$note" ]; then
            # 入力待ちの通知は黄色で目立たせ、待機セッションの最後の返答は控えめに
            local ncolor=$C_DIM
            [ "$status" = "waiting" ] && ncolor=$C_WAITING
            body="${body}     ${ncolor}${note:0:$((width - 7))}${C_RESET}${EOL}"$'\n'
        fi
        body="${body}${EOL}"$'\n'
    done <<EOF
$(rows)
EOF

    printf ' %sClaude Code sessions%s%s\n' "$C_BOLD" "$C_RESET" "$EOL"
    printf ' %s%s %d  %s%s %d  %s%s %d%s%s\n' \
        "$C_WAITING" "$GLYPH_WAITING" "$cn" \
        "$C_WORKING" "$GLYPH_WORKING" "$cw" \
        "$C_IDLE" "$GLYPH_IDLE" "$ci" "$C_RESET" "$EOL"
    printf ' %s%s%s%s\n%s\n' "$C_DIM" "──────────────────────────" "$C_RESET" "$EOL" "$EOL"

    if [ "$total" -eq 0 ]; then
        printf ' %s(no active sessions)%s%s\n' "$C_DIM" "$C_RESET" "$EOL"
    else
        printf '%s' "$body"
    fi
}

# セッション詳細をpopup内に描画する (cwd / ブランチ / プロンプト / 直近の会話)
render_detail() {
    local sid=$1
    local f="$STATE_DIR/$sid.json"
    if [ ! -f "$f" ]; then
        printf ' state not found: %s\n' "$sid"
        printf '\n %s[press any key to close]%s' "$C_DIM" "$C_RESET"
        read -r -n 1 2>/dev/null
        return 1
    fi
    local status project tsess twin tpidx cwd updated fprompt lprompt notif reply tp
    IFS="$ROW_SEP" read -r status project tsess twin tpidx cwd updated fprompt lprompt notif reply tp <<EOF
$(jq -r '[
        (.status // "idle"), (.project // "?"), (.tmux_session // ""),
        (.tmux_window // ""), (.tmux_pane_index // ""), (.cwd // ""),
        ((.updated_at // 0) | tostring),
        (.first_prompt // "" | gsub("[\\x00-\\x1f]"; " ")),
        (.last_prompt // "" | gsub("[\\x00-\\x1f]"; " ")),
        (.last_notification // "" | gsub("[\\x00-\\x1f]"; " ")),
        (.last_reply // "" | gsub("[\\x00-\\x1f]"; " ")),
        (.transcript_path // "")
    ] | join("\u001f")' "$f" 2>/dev/null)
EOF
    local now age glyph color branch
    now=$(date +%s)
    age=$(fmt_age $((now - $(as_int "${updated:-0}"))))
    glyph=$(glyph_for "$status")
    color=$(color_for "$status")
    branch=$(git -C "$cwd" branch --show-current 2>/dev/null)

    printf ' %s%s %s%s %s(%s, %s)%s\n\n' \
        "$color" "$glyph" "${tsess:-$project}" "$C_RESET" "$C_DIM" "$status" "$age" "$C_RESET"
    printf ' %scwd:%s    %s\n' "$C_DIM" "$C_RESET" "$cwd"
    [ -n "$branch" ] && printf ' %sbranch:%s %s\n' "$C_DIM" "$C_RESET" "$branch"
    [ -n "$tsess" ] && printf ' %stmux:%s   %s %s.%s\n' "$C_DIM" "$C_RESET" "$tsess" "$twin" "$tpidx"
    if [ -n "$fprompt" ]; then
        printf '\n %s最初のプロンプト:%s %s\n' "$C_DIM" "$C_RESET" "$fprompt"
    fi
    if [ -n "$lprompt" ] && [ "$lprompt" != "$fprompt" ]; then
        printf ' %s最後のプロンプト:%s %s\n' "$C_DIM" "$C_RESET" "$lprompt"
    fi
    [ "$status" = "waiting" ] && [ -n "$notif" ] && \
        printf ' %s通知:%s %s%s%s\n' "$C_DIM" "$C_RESET" "$C_WAITING" "$notif" "$C_RESET"
    [ -n "$reply" ] && printf ' %s最後の返答:%s %s\n' "$C_DIM" "$C_RESET" "$reply"

    if [ -n "$tp" ] && [ -f "$tp" ]; then
        printf '\n %s── 直近の会話 (» はユーザー) ──%s\n' "$C_DIM" "$C_RESET"
        local line
        tail -c 200000 "$tp" 2>/dev/null | tail -n +2 | jq -r '
            select(.type == "user" or .type == "assistant")
            | . as $m
            | (.message.content
               | if type == "string" then .
                 else ([.[]? | select(type == "object" and .type == "text") | .text]
                       | join(" "))
                 end)
            | gsub("\\s+"; " ") | sub("^ "; "") | sub(" $"; "")
            | select(length > 0)
            | (if $m.type == "user" then "» " else "  " end) + .' 2>/dev/null | \
            tail -8 | while IFS= read -r line; do
                printf ' %s\n' "${line:0:110}"
            done
    fi
    printf '\n %s[press any key to close]%s' "$C_DIM" "$C_RESET"
    read -r -n 1 2>/dev/null
}

watch_loop() {
    tput civis 2>/dev/null
    # 終了時: カーソル復帰 + サイドバーpane記録を掃除 (トグルの状態と整合させる)。
    # 記録が「自分のpane」を指しているときだけ消す。prefix+a 連打で
    # 「旧watcherの終了」が「新サイドバーの登録」より後に走ると、生きている
    # サイドバーの記録を消してしまい、次のトグルが2枚目を開いて1枚目が
    # 閉じられなくなる。
    trap 'tput cnorm 2>/dev/null
          [ "$(tmux show-option -wqv @claude_sidebar_pane 2>/dev/null)" = "${TMUX_PANE:-}" ] \
              && tmux set-option -wu @claude_sidebar_pane 2>/dev/null' EXIT
    # 全消去(\033[2J)は一瞬白くなってちらつくため、ホーム(\033[H)から
    # 行末消去付きで上書きし、最後に余った下部だけ消す(\033[J)
    EOL=$'\033[K'
    local key target dkey dsid
    while :; do
        printf '\033[H'
        render_list "$(tput cols 2>/dev/null || echo 44)"
        printf ' %s1-9: jump  i+N: detail  q: close%s%s\n\033[J' "$C_DIM" "$C_RESET" "$EOL"
        key=""
        read -r -t 2 -n 1 key 2>/dev/null
        case "$key" in
            q) break ;;
            i)
                printf '\n %sdetail #?%s ' "$C_DIM" "$C_RESET"
                dkey=""
                read -r -n 1 dkey 2>/dev/null
                case "$dkey" in
                    [1-9])
                        dsid=$(printf '%s' "${TARGETS[$dkey]:-}" | cut -f4)
                        if [ -n "$dsid" ]; then
                            tmux display-popup -w 80% -h 70% -E \
                                "$HOME/.config/claude/bin/claude-status detail $dsid" 2>/dev/null
                        fi
                        ;;
                esac
                ;;
            [1-9])
                # ジャンプ成功時はループを抜けてサイドバーpaneを閉じる
                target="${TARGETS[$key]:-}"
                if [ -n "$target" ]; then
                    jump_to "${target%%$'\t'*}" \
                            "$(printf '%s' "$target" | cut -f2)" \
                            "$(printf '%s' "$target" | cut -f3)" \
                        && break
                fi
                ;;
        esac
    done
}

render_bar() {
    local cw=0 cn=0 ci=0
    local status _rest
    while IFS="$ROW_SEP" read -r status _rest; do
        case "$status" in
            working) cw=$((cw + 1)) ;;
            waiting) cn=$((cn + 1)) ;;
            idle)    ci=$((ci + 1)) ;;
        esac
    done <<EOF
$(rows)
EOF
    local seg=""
    [ "$cn" -gt 0 ] && seg="${seg}#[fg=#f9e2af]${GLYPH_WAITING}${cn} "
    [ "$cw" -gt 0 ] && seg="${seg}#[fg=#89b4fa]${GLYPH_WORKING}${cw} "
    [ "$ci" -gt 0 ] && seg="${seg}#[fg=#6c7086]${GLYPH_IDLE}${ci} "
    printf '%s' "$seg"
}

# tmuxセッションごとに最優先状態 (waiting > working > idle) のグリフを返す
render_sessions() {
    set -- "$STATE_DIR"/*.json
    [ -e "$1" ] || return 0
    local out
    out=$(sessions_jq "$@")
    if [ -z "$out" ]; then
        quarantine_broken
        set -- "$STATE_DIR"/*.json
        [ -e "$1" ] || return 0
        out=$(sessions_jq "$@")
    fi
    [ -n "$out" ] && printf '%s\n' "$out"
    return 0
}

sessions_jq() {
    jq -rs '
        def prio: {waiting: 0, working: 1, idle: 2}[.] // 3;
        def glyph: {waiting: "🔔", working: "⚙", idle: "✓"}[.] // "✓";
        map(select(.tmux_session != null and .tmux_session != ""))
        | group_by(.tmux_session)
        | .[]
        | [.[0].tmux_session, (map(.status // "idle") | min_by(prio) | glyph)]
        | @tsv
    ' "$@" 2>/dev/null
}

mkdir -p "$STATE_DIR" 2>/dev/null
cleanup_stale

case "${1:-list}" in
    bar)      render_bar ;;
    list)     render_list "$(tput cols 2>/dev/null || echo 44)" ;;
    watch)    watch_loop ;;
    sessions) render_sessions ;;
    jump)     render_jump ;;
    detail)   render_detail "$2" ;;
    *)
        echo "Usage: claude-status [bar|list|watch|sessions|jump|detail <session_id>]" >&2
        exit 1
        ;;
esac
