#!/usr/bin/env bash
# Claude状態サイドバーのトグル (tmux prefix+a)
# 現在のwindowの右端に claude-status watch のpaneを開閉する
export PATH="/opt/homebrew/bin:/usr/bin:/bin:$PATH"

pane=$(tmux show-option -wqv @claude_sidebar_pane)
if [ -n "$pane" ] && tmux list-panes -F '#{pane_id}' | grep -qx "$pane"; then
    tmux kill-pane -t "$pane"
    tmux set-option -wu @claude_sidebar_pane
else
    # -d を付けずフォーカスをサイドバーに移す (数字キー1-9のジャンプ操作を受けるため)
    new_pane=$(tmux split-window -h -l 44 -P -F '#{pane_id}' \
        "$HOME/.config/claude/bin/claude-status watch")
    tmux set-option -w @claude_sidebar_pane "$new_pane"
fi
