# ===== Default (accident prevention) =====
[user]
	name = INVALID
	email = invalid@example.com

[include]
	path = ~/.gitconfig.local
	path = ~/.config/delta/catppuccin.gitconfig
[core]
  pager = delta
  quotepath = false
  editor = vim
[delta]
  features = catppuccin-mocha
  syntax-theme = Catppuccin Mocha
  navigate = true
  line-numbers = true
  side-by-side = false
[interactive]
  diffFilter = delta --color-only
[color]
  ui = true
[secrets]
#	providers = git secrets --aws-provider
#	patterns = (A3T[A-Z0-9]|AKIA|AGPA|AIDA|AROA|AIPA|ANPA|ANVA|ASIA)[A-Z0-9]{16}
#	patterns = (\"|')?(AWS|aws|Aws)?_?(SECRET|secret|Secret)?_?(ACCESS|access|Access)?_?(KEY|key|Key)(\"|')?\\s*(:|=>|=)\\s*(\"|')?[A-Za-z0-9/\\+=]{40}(\"|')?
#	patterns = (\"|')?(AWS|aws|Aws)?_?(ACCOUNT|account|Account)_?(ID|id|Id)?(\"|')?\\s*(:|=>|=)\\s*(\"|')?[0-9]{4}\\-?[0-9]{4}\\-?[0-9]{4}(\"|')?
#	allowed = AKIAIOSFODNN7EXAMPLE
#	allowed = wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
[init]
	templatedir = ~/.git-templates/git-secrets
	defaultBranch = main
[pull]
	rebase = true
[commit]
	template = ~/.config/git/message
[diff]
	algorithm = histogram
[merge]
	conflictstyle = diff3
[rerere]
	enabled = true
[fetch]
	prune = true
[ghq]
	root = ~/repos
# gh is looked up on PATH (not /opt/homebrew/bin/gh) so the same config works
# with Linuxbrew on Linux/WSL. A git started without Homebrew on PATH (some
# macOS GUI apps) gets no helper and falls back to its own prompt.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
