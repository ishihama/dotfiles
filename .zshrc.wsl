# Clipboard: pbcopy is a script on PATH (~/.local/bin/pbcopy ->
# .config/shell/bin/wsl/pbcopy) that converts to UTF-16LE for clip.exe, so
# tmux copy-pipe can call it too. Drop the xsel alias from .zshrc.linux, which
# would otherwise shadow it in interactive shells.
unalias pbcopy 2>/dev/null

# DISPLAY is left alone: WSLg sets DISPLAY=:0 itself.


# tmux wsl-terminal
[[ -z "$TMUX" && -n "$USE_TMUX" ]] && {
    [[ -n "$ATTACH_ONLY" ]] && {
        tmux a 2>/dev/null || {
            cd && exec tmux
        }
        exit
    }

    tmux new-window -c "$PWD" 2>/dev/null && exec tmux a
    exec tmux
}
